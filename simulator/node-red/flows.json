[
  {
    "id": "simulator-flow",
    "type": "tab",
    "label": "SCADA process simulator",
    "disabled": false,
    "info": "Automatic process model feeding three Modbus TCP servers."
  },
  {
    "id": "tick",
    "type": "inject",
    "z": "simulator-flow",
    "name": "1 second simulation tick",
    "props": [{ "p": "payload" }],
    "repeat": "1",
    "crontab": "",
    "once": true,
    "onceDelay": 0.5,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 160,
    "y": 120,
    "wires": [["simulate"]]
  },
  {
    "id": "simulate",
    "type": "function",
    "z": "simulator-flow",
    "name": "Advance model and encode registers",
    "func": "const simulator = global.get('simulator')\nlet state = flow.get('simulatorState') || simulator.initialState()\nstate = simulator.step(state, 1)\nflow.set('simulatorState', state)\nconst writes = simulator.messagesForSlaves(state)\nreturn [\n    { payload: simulator.dashboardState(state) },\n    writes.tank,\n    writes.pumps,\n    writes.utility\n]",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 120,
    "wires": [
      ["dashboard"],
      ["tank-server"],
      ["pump-server"],
      ["utility-server"]
    ]
  },
  {
    "id": "apply-controls",
    "type": "function",
    "z": "simulator-flow",
    "name": "Apply dashboard control",
    "func": "const simulator = global.get('simulator')\nlet state = flow.get('simulatorState') || simulator.initialState()\nstate = simulator.applyControl(state, msg.topic, msg.payload)\nflow.set('simulatorState', state)\nreturn null",
    "outputs": 0,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 770,
    "y": 60,
    "wires": []
  },
  {
    "id": "tank-server",
    "type": "modbus-server",
    "z": "simulator-flow",
    "name": "Tank PLC - unit 1",
    "logEnabled": false,
    "hostname": "0.0.0.0",
    "serverPort": "1502",
    "responseDelay": 20,
    "delayUnit": "ms",
    "coilsBufferSize": 100,
    "holdingBufferSize": 100,
    "inputBufferSize": 100,
    "discreteBufferSize": 100,
    "showErrors": true,
    "showStatusActivities": false,
    "x": 780,
    "y": 120,
    "wires": [[], [], [], [], []]
  },
  {
    "id": "pump-server",
    "type": "modbus-server",
    "z": "simulator-flow",
    "name": "Pump PLC - unit 2",
    "logEnabled": false,
    "hostname": "0.0.0.0",
    "serverPort": "1503",
    "responseDelay": 20,
    "delayUnit": "ms",
    "coilsBufferSize": 100,
    "holdingBufferSize": 100,
    "inputBufferSize": 100,
    "discreteBufferSize": 100,
    "showErrors": true,
    "showStatusActivities": false,
    "x": 780,
    "y": 180,
    "wires": [[], [], [], [], []]
  },
  {
    "id": "utility-server",
    "type": "modbus-server",
    "z": "simulator-flow",
    "name": "Utility PLC - unit 3",
    "logEnabled": false,
    "hostname": "0.0.0.0",
    "serverPort": "1504",
    "responseDelay": 20,
    "delayUnit": "ms",
    "coilsBufferSize": 100,
    "holdingBufferSize": 100,
    "inputBufferSize": 100,
    "discreteBufferSize": 100,
    "showErrors": true,
    "showStatusActivities": false,
    "x": 790,
    "y": 240,
    "wires": [[], [], [], [], []]
  },
  {
    "id": "dashboard",
    "type": "ui-template",
    "z": "simulator-flow",
    "group": "dashboard-group",
    "page": "",
    "ui": "",
    "name": "Process overview and controls",
    "order": 1,
    "width": 12,
    "height": 12,
    "head": "",
    "format": "<template>\n  <div v-if=\"state\" class=\"sim-wrap\">\n    <div class=\"sim-header\">\n      <div><h2>Process Simulator</h2><small>Three Modbus TCP PLCs · live values update every second</small></div>\n      <div class=\"mode\" :class=\"state.controls.automatic ? 'auto' : 'manual'\">{{ state.controls.automatic ? 'AUTO' : 'MANUAL' }}</div>\n    </div>\n    <div class=\"metrics\">\n      <div class=\"metric\"><span>Tank level</span><b>{{ fixed(state.level) }} %</b><v-progress-linear :model-value=\"bounded(state.level)\" height=\"10\" rounded /></div>\n      <div class=\"metric\"><span>Temperature</span><b>{{ fixed(state.temperature) }} °C</b><v-progress-linear :model-value=\"bounded(state.temperature)\" height=\"10\" rounded /></div>\n      <div class=\"metric\"><span>Process flow</span><b>{{ fixed(state.totalFlow) }} m³/h</b><v-progress-linear :model-value=\"bounded(state.totalFlow)\" height=\"10\" rounded /></div>\n      <div class=\"metric\"><span>Pressure</span><b>{{ fixed(state.pressure) }} bar</b><v-progress-linear :model-value=\"bounded(state.pressure * 10)\" height=\"10\" rounded /></div>\n    </div>\n    <div class=\"trend-card\">\n      <span>60-second trends: level / temperature / flow</span>\n      <svg viewBox=\"0 0 600 120\" preserveAspectRatio=\"none\">\n        <polyline :points=\"trendPoints('level', 100)\" class=\"level-line\" />\n        <polyline :points=\"trendPoints('temperature', 120)\" class=\"temp-line\" />\n        <polyline :points=\"trendPoints('flow', 100)\" class=\"flow-line\" />\n      </svg>\n    </div>\n    <div class=\"columns\">\n      <section>\n        <h3>Equipment</h3>\n        <div class=\"equipment\"><b>Pump 1</b><span :class=\"lamp(state.status.pump1Running)\"></span>{{ state.status.pump1Running ? 'Running' : 'Stopped' }} · {{ fixed(state.pump1Current) }} A</div>\n        <div class=\"equipment\"><b>Pump 2</b><span :class=\"lamp(state.status.pump2Running)\"></span>{{ state.status.pump2Running ? 'Running' : 'Stopped' }} · {{ fixed(state.pump2Current) }} A</div>\n        <div class=\"equipment\"><b>Inlet valve</b><span :class=\"lamp(state.inletPosition > 5)\"></span>{{ fixed(state.inletPosition) }} %</div>\n        <div class=\"equipment\"><b>Outlet valve</b><span :class=\"lamp(state.outletPosition > 5)\"></span>{{ fixed(state.outletPosition) }} %</div>\n        <div class=\"equipment\"><b>Cooling valve</b><span :class=\"lamp(state.coolingValvePosition > 5)\"></span>{{ fixed(state.coolingValvePosition) }} %</div>\n      </section>\n      <section>\n        <h3>Controls</h3>\n        <label class=\"check\"><input type=\"checkbox\" :checked=\"state.controls.automatic\" @change=\"control('automatic', $event.target.checked)\"> Automatic control</label>\n        <label>Simulation speed: {{ state.controls.speed }}×<input type=\"range\" min=\"0.1\" max=\"5\" step=\"0.1\" :value=\"state.controls.speed\" @change=\"control('speed', $event.target.value)\"></label>\n        <label class=\"check\"><input type=\"checkbox\" :disabled=\"state.controls.automatic\" :checked=\"state.controls.pump1Command\" @change=\"control('pump1Command', $event.target.checked)\"> Pump 1 command</label>\n        <label class=\"check\"><input type=\"checkbox\" :disabled=\"state.controls.automatic\" :checked=\"state.controls.pump2Command\" @change=\"control('pump2Command', $event.target.checked)\"> Pump 2 command</label>\n        <label>Inlet command: {{ fixed(state.controls.inletCommand) }} %<input type=\"range\" min=\"0\" max=\"100\" :disabled=\"state.controls.automatic\" :value=\"state.controls.inletCommand\" @change=\"control('inletCommand', $event.target.value)\"></label>\n        <label>Outlet command: {{ fixed(state.controls.outletCommand) }} %<input type=\"range\" min=\"0\" max=\"100\" :disabled=\"state.controls.automatic\" :value=\"state.controls.outletCommand\" @change=\"control('outletCommand', $event.target.value)\"></label>\n      </section>\n      <section>\n        <h3>Fault injection</h3>\n        <label v-for=\"fault in faultOptions\" :key=\"fault.key\" class=\"check fault\"><input type=\"checkbox\" :checked=\"state.faults[fault.key]\" @change=\"control(fault.key, $event.target.checked)\"> {{ fault.label }}</label>\n        <v-btn size=\"small\" color=\"primary\" @click=\"control('resetFaults', true)\">Reset all faults</v-btn>\n      </section>\n    </div>\n    <div class=\"alarms\" v-if=\"activeAlarms.length\"><b>Active conditions:</b> {{ activeAlarms.join(' · ') }}</div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () {\n    return {\n      state: null,\n      history: [],\n      faultOptions: [\n        { key: 'pump1Trip', label: 'Pump 1 trip' },\n        { key: 'pump2Trip', label: 'Pump 2 trip' },\n        { key: 'inletStuck', label: 'Inlet valve stuck' },\n        { key: 'outletStuck', label: 'Outlet valve stuck' },\n        { key: 'highTemperature', label: 'High temperature source' },\n        { key: 'sensorFreeze', label: 'Freeze analog sensors' },\n        { key: 'sensorBad', label: 'Bad tank sensors' }\n      ]\n    }\n  },\n  computed: {\n    activeAlarms () {\n      if (!this.state) return []\n      const alarms = []\n      if (this.state.status.levelHigh) alarms.push('Tank level high')\n      if (this.state.status.levelLow) alarms.push('Tank level low')\n      if (this.state.status.temperatureHigh) alarms.push('Temperature high')\n      if (this.state.status.flowLow) alarms.push('Flow low')\n      if (this.state.faults.pump1Trip) alarms.push('Pump 1 tripped')\n      if (this.state.faults.pump2Trip) alarms.push('Pump 2 tripped')\n      if (this.state.sensorBad) alarms.push('Tank sensor bad')\n      return alarms\n    }\n  },\n  watch: {\n    msg: {\n      handler (msg) {\n        if (!msg || !msg.payload) return\n        this.state = msg.payload\n        this.history.push({ level: msg.payload.level, temperature: msg.payload.temperature, flow: msg.payload.totalFlow })\n        if (this.history.length > 60) this.history.shift()\n      },\n      deep: true,\n      immediate: true\n    }\n  },\n  methods: {\n    fixed (value) { return Number(value).toFixed(1) },\n    bounded (value) { return Math.min(100, Math.max(0, Number(value))) },\n    lamp (on) { return on ? 'lamp on' : 'lamp' },\n    control (topic, payload) { this.send({ topic, payload }) },\n    trendPoints (key, max) {\n      if (this.history.length < 2) return ''\n      return this.history.map((point, index) => `${index * (600 / 59)},${120 - this.bounded(point[key] / max * 100) * 1.15}`).join(' ')\n    }\n  }\n}\n</script>\n\n<style>\n.sim-wrap { padding: 8px; font-family: system-ui, sans-serif; }\n.sim-header, .metrics, .columns { display: flex; gap: 12px; }\n.sim-header { justify-content: space-between; align-items: center; }\n.sim-header h2 { margin: 0; }\n.mode { padding: 7px 13px; border-radius: 16px; font-weight: 700; background: #555; }\n.mode.auto { background: #19733b; } .mode.manual { background: #9a5c00; }\n.metrics { display: grid; grid-template-columns: repeat(4, 1fr); margin: 16px 0; }\n.metric, section, .trend-card { background: rgba(127,127,127,.12); border-radius: 8px; padding: 12px; }\n.metric span, .metric b { display: block; } .metric b { font-size: 1.35rem; margin: 5px 0 9px; }\n.trend-card svg { width: 100%; height: 120px; margin-top: 8px; background: rgba(0,0,0,.15); }\n.trend-card polyline { fill: none; stroke-width: 2.5; } .level-line { stroke: #42a5f5; } .temp-line { stroke: #ef5350; } .flow-line { stroke: #66bb6a; }\n.columns { margin-top: 12px; } section { flex: 1; } section h3 { margin-top: 0; }\n.equipment { display: grid; grid-template-columns: 110px 14px 1fr; align-items: center; margin: 10px 0; }\n.lamp { width: 10px; height: 10px; border-radius: 50%; background: #777; display: inline-block; } .lamp.on { background: #38c968; box-shadow: 0 0 6px #38c968; }\nlabel { display: block; margin: 9px 0; } label input[type=range] { width: 100%; } .check input { margin-right: 8px; }\n.fault { color: #ef9a9a; } .alarms { margin-top: 12px; padding: 10px; border-radius: 6px; background: #8e2a2a; color: white; }\n@media (max-width: 900px) { .metrics { grid-template-columns: repeat(2, 1fr); } .columns { flex-direction: column; } }\n</style>",
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 760,
    "y": 300,
    "wires": [["apply-controls"]]
  },
